# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Local configuration and pipeline data. These folders hold rips, output and
# the IMDb index, so they must never enter the repository.
mkv-transcode.toml
mkv-transcode.toml.bak
config.toml
*.bak
incoming/
transcoded/
processed/
workdir/
imdb/
.state.sqlite
*.work.mkv
*.log

# The IMDb test fixtures are small samples of public IMDb data. The test suite
# needs them, so re-include them even when a global ignore rule covers '*.gz'.
!tests/fixtures/*.gz

# Editors
.vscode/
.idea/
*.swp
